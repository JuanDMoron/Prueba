PORT=3000

# Application ID que te da Teller al registrar tu app en https://teller.io/dashboard
TELLER_APPLICATION_ID=app_xxxxxxxxxxxxxxxxxxxx

# sandbox | development | production
# - sandbox: datos ficticios, no requiere certificado.
# - development / production: cuentas bancarias reales, requieren certificado mTLS.
TELLER_ENVIRONMENT=sandbox

# Rutas al certificado y llave privada mTLS descargados del dashboard de Teller.
# Solo son obligatorios cuando TELLER_ENVIRONMENT es development o production.
TELLER_CERT_PATH=./certs/certificate.pem
TELLER_KEY_PATH=./certs/private_key.pem
